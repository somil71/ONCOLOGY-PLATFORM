h['mask'].to(DEVICE, non_blocking=True)\n","        times = batch['time'].to(DEVICE, non_blocking=True)\n","        events = batch['event'].to(DEVICE, non_blocking=True)\n","        \n","        risk, _, _, _ = model(wsi, rna, cli, mask)\n","        loss = cox_loss(risk, times, events)\n","        \n","        if not torch.isnan(loss) and not torch.isinf(loss):\n","            loss.backward()\n","            optimizer.step()\n","            ep_loss += loss.item()\n","            \n","        pbar.set_postfix({'loss': f\"{loss.item():.4f}\"})\n","        \n","    avg_loss = ep_loss / max(len(train_dl), 1)\n","    history['loss'].append(avg_loss)\n","    print(f\"Epoch {epoch:02d}/{CFG['epochs']:02d} | Train Cox Loss: {avg_loss:.4f}\")\n","\n","print(\"\\n✅ Training Complete!\")\n"]},{"cell_type":"markdown","id":"6a5a1226","metadata":{"papermill":{"duration":0.009333,"end_time":"2026-09-10T03:22:06.043711+00:00","exception":false,"start_time":"2026-09-10T03:22:06.034378+00:00","status":"completed"},"tags":[]},"source":["## Cell 10 — Evaluation, Visualization & API Export"]},{"cell_type":"code","execution_count":10,"id":"36726214","metadata":{"execution":{"iopub.execute_input":"2026-09-10T03:22:06.064178Z","iopub.status.busy":"2026-09-10T03:22:06.063775Z","iopub.status.idle":"2026-09-10T03:27:37.092245Z","shell.execute_reply":"2026-09-10T03:27:37.091134Z"},"papermill":{"duration":331.04115,"end_time":"2026-09-10T03:27:37.094252+00:00","exception":false,"start_time":"2026-09-10T03:22:06.053102+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","=================================================================\n","  📊 GENERATING PUBLICATION CHARTS & API EXPORT\n","=================================================================\n","[*] Running inference on Validation Set...\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"e8c57e52934d482cbab081f8f5d6f2a6","version_major":2,"version_minor":0},"text