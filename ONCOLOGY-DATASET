b.glob(f\"{CFG['dir_multimodal']}/*/*/TCGA-*\") + \\\n","                    glob.glob(f\"{CFG['dir_multimodal']}/*/*/*/TCGA-*\")\n","            self.img_folder = os.path.dirname(paths[0]) if paths else CFG['dir_multimodal']\n","        except:\n","            self.img_folder = CFG['dir_multimodal']\n","\n","    def __len__(self):\n","        return len(self.df)\n","\n","    def __getitem__(self, idx):\n","        patient_id = self.df.iloc[idx]['Patient_ID']\n","        \n","        # Initialize Tensors (1 WSI, 2 RAD, 3 RNA, 4 CLI)\n","        wsi_tensor = torch.zeros((CFG['max_patches'], 768))\n","        rad_tensor = torch.zeros((CFG['max_patches'], 512))\n","        mask = torch.zeros(4) # [WSI, RAD, RNA, CLI]\n","        \n","        # 1. Image Modalities (WSI & Radiology)\n","        all_files = glob.glob(f\"{self.img_folder}/{patient_id}/**/*\", recursive=True)\n","        all_files = [p for p in all_files if os.path.isfile(p)]\n","        \n","        wsi_files = [p for p in all_files if p.endswith('.jpg') or p.endswith('.png')]\n","        rad_files = [p for p in all_files if not p.endswith('.jpg') and not p.endswith('.png')]\n","        \n","        # Process WSI\n","        if len(wsi_files) > 0:\n","            mask[0] = 1.0\n","            loaded = []\n","            for p in wsi_files[:CFG['max_patches']]:\n","                try:\n","                    loaded.append(img_transform(Image.open(p).convert('RGB')))\n","                except: pass\n","            if loaded:\n","                with torch.no_grad():\n","                    wsi_tensor[:len(loaded)] = wsi_model(torch.stack(loaded).to(DEVICE)).cpu()\n","                    \n","        # Process Radiology (DICOM)\n","        if len(rad_files) > 0:\n","            mask[1] = 1.0\n","            loaded = []\n","            for p in rad_files[:CFG['max_patches']]:\n","                try:\n","                    ds = pydicom.dcmread(p)\n","                    arr = ds.pixel_array.astype(float)\n","                    arr = (arr - np.min(arr)) / (np.max(arr) - np.min(arr) + 1e-8)\n","                    arr = (arr * 255).astype(np.uint8)\n","                    img = Image.fromarray(arr if len(arr.shape)==2 else arr[0]).convert('RGB')\n","                    loaded.append(img_transform(img))\n","                except: pass\n","            if loaded:\n","                with torch.no_grad():\n","                    rad_tensor[:len(loaded)] = rad_model(torch.stack(loaded).to(DEVICE)).cpu()\n","\n","        # 2 & 3. RNA & Clinical\n","        rna = torch.tensor(self.rna_df.loc[patient_id].values, dtype=torch.float32) if patient_id in self.rna_df.index else torch.zeros(self.rna_df.shape[1])\n","        cli = torch.tensor(self.cli_df.loc[patient_id].values, dtype=torch.float32) if patient_id in self.cli_df.index else torch.zeros(self.cli_df.shape[1])\n","        if patient_id in self.rna_df.index: mask[2] = 1.0\n","        if patient_id in self.cli_df.index: mask[3] = 1.0\n","        \n","        # Target\n","        time = self.df.iloc[idx]['time']\n","        event = self.df.iloc[idx]['event']\n","        \n","        return {'wsi': wsi_tensor, 'rad': rad_tensor, 'rna': rna, 'cli': cli, 'mask': mask, 'time': time, 'event': event}"]},{"cell_type":"code","execution_count":5,"id":"4ca367e0","metadata":{"execution":{"iopub.execute_input":"2026-09-12T08:03:08.969539Z","iopub.status.busy":"2026-09-12T08:03:08.969267Z","iopub.status.idle":"2026-09-12T08:03:08.981125Z","shell.execute_reply":"2026-09-12T08:03:08.980504Z"},"papermill":{"duration":0.017293,"end_time":"2026-09-12T08:03:08.982473+00:00","exception":false,"start_time":"2026-09-12T08:03:08.96518+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class SafeAttentionFusion(nn.Module):\n","    def __init__(self, embed_dim=16, num_modalities=4):\n","        super().__init__()\n","        self.query = nn.Parameter(torch.randn(1, 1, embed_dim))\n","        self.key = nn.Linear(embed_dim, embed_dim)\n","        self.value = nn.Linear(embed_dim, embed_dim)\n","        \n","    def forward(self, features, mask):\n","        B = features.size(0)\n","        q = self.query.expand(B, -1, -1)\n","        k = self.key(features)\n","        v = self.value(features)\n","        \n","        scores = torch.bmm(q, k.transpose(1, 2)) / math.sqrt(k.size(-1))\n","        scores.masked_fill_(mask.unsqueeze(1) == 0, float('-inf'))\n","        \n","        attn = F.softmax(scores, dim=-1)\n","        attn = torch.where(torch.isnan(attn), torch.zeros_like(attn), attn)\n","        \n","        fused = torch.bmm(attn, v).squeeze(1)\n","        return fused, attn.squeeze(1)\n","\n","class EvidentialHead(nn.Module):\n","    def __init__(self, in_features):\n","        super().__init__()\n","        self.fc = nn.Linear(in_features, 2)\n","    def forward(self, x):\n","        evidence = F.softplus(self.fc(x))\n","        alpha = evidence + 1\n","        S = torch.sum(alpha, dim=1, keepdim=True)\n","        risk = alpha[:, 1] / S.squeeze()\n","        uncertainty = 2 / S.squeeze()\n","        return risk, uncertainty\n","\n","class CancerFusionPhase2(nn.Module):\n","    def __init__(self, rna_dim, cli_dim):\n","        super().__init__()\n","        self.wsi_proj = nn.Sequential(nn.Linear(768, 128), nn.ReLU(), nn.Linear(128, 16))\n","        self.rad_proj = nn.Sequential(nn.Linear(512, 128), nn.ReLU(), nn.Linear(128, 16))\n","        self.rna_enc  = nn.Sequential(nn.Linear(rna_dim, 256), nn.AlphaDropout(0.1), nn.SELU(), nn.Linear(256, 16))\n","        self.cli_enc  = nn.Sequential(nn.Linear(cli_dim, 64), nn.LayerNorm(64), nn.ReLU(), nn.Linear(64, 16))\n","        \n","        self.fusion = SafeAttentionFusion(embed_dim=16, num_modalities=4)\n","        self.head = EvidentialHead(in_features=16)\n","\n","    def forward(self, wsi, rad, rna, cli, mask):\n","        f_wsi = self.wsi_proj(wsi.mean(dim=1))\n","        f_rad = self.rad_proj(rad.mean(dim=1))\n","        f_rna = self.rna_enc(rna)\n","        f_cli = self.cli_enc(cli)\n","        \n","        stacked = torch.stack([f_wsi, f_rad, f_rna, f_cli], dim=1)\n","        fused, attn = self.fusion(stacked, mask)\n","        risk, unc = self.head(fused)\n","        \n","        return risk, unc, attn\n","\n","def cox_loss(risk, times, events):\n","    events = events.float()\n","    ix = torch.argsort(times, descending=True)\n","    risk, events = risk[ix], events[ix]\n","    log_risk = torch.log(risk + 1e-8)\n","    cum_risk = torch.logcumsumexp(log_risk, dim=0)\n","    loss = -torch.sum((log_risk - cum_risk) * events) / (torch.sum(events) + 1e-8)\n","    return loss"]},{"cell_type":"code","execution_count":6,"id":"4da7335b","metadata":{"execution":{"iopub.execute_input":"2026-09-12T08:03:08.989494Z","iopub.status.busy":"2026-09-12T08:03:08.989206Z","iopub.status.idle":"2026-09-12T08:03:09.649234Z","shell.execute_reply":"2026-09-12T08:03:09.648279Z"},"papermill":{"duration":0.665745,"end_time":"2026-09-12T08:03:09.650986+00:00","exception":false,"start_time":"2026-09-12T08:03:08.985241+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[*] Processing Phase 2 Pan-Cancer CSVs...\n","Auto-Found Clinical Data: /kaggle/input/datasets/sepehreslamimoghadam/breast-cancer-vision-and-genomic-fusion-ml-ready/Clinical_Demographic_Data.csv\n","Auto-Found Genomic Data: /kaggle/input/datasets/sepehreslamimoghadam/breast-cancer-vision-and-genomic-fusion-ml-ready/Mutations_Dataset.csv\n","Auto-Found Demographic Data: /kaggle/input/datasets/sepehreslamimoghadam/breast-cancer-vision-and-genomic-fusion-ml-ready/Clinical_Demographic_Data.csv\n","✅ Phase 2 Data & Engine Ready!\n"]}],"source":["print(\"[*] Processing Phase 2 Pan-Cancer CSVs...\")\n","# Bulletproof CSV File Discovery\n","# FAST O(1) CSV Discovery (prevents Kaggle network drive I/O stall)\n","all_csvs = glob.glob(f\"{CFG['dir_multimodal']}/*.csv\") + glob.glob(f\"{CFG['dir_multimodal']}/*/*.csv\")\n","cli_path = next((f for f in all_csvs if 'treatment' in f.lower() or 'clinical' in f.lower()), all_csvs[0] if len(all_csvs) > 0 else \"\")\n","rna_path = next((f for f in all_csvs if 'rna' in f.lower() or 'cnv' in f.lower() or 'mutation' in f.lower()), all_csvs[1] if len(all_csvs) > 1 else \"\")\n","demo_path = next((f for f in all_csvs if 'demographic' in f.lower() or 'survival' in f.lower()), all_csvs[2] if len(all_csvs) > 2 else \"\")\n","\n","print(f\"Auto-Found Clinical Data: {cli_path}\")\n","print(f\"Auto-Found Genomic Data: {rna_path}\")\n","print(f\"Auto-Found Demographic Data: {demo_path}\")\n","\n","# Bulletproof Pan-Cancer ID Standardizer\n","def standardize_id(df):\n","    for col in ['Patient_ID', 'bcr_patient_barcode', 'patient_id', 'Patient ID', 'PATIENT_ID']:\n","        if col in df.columns:\n","            df = df.rename(columns={col: 'Patient_ID'})\n","            return df.set_index('Patient_ID')\n","    return df.set_index(df.columns[0]) # Fallback to first column\n","\n","cli_df = standardize_id(pd.read_csv(cli_path, encoding='latin1'))\n","cli_df = cli_df.select_dtypes(include=[np.number]).fillna(0)\n","\n","rna_df = standardize_id(pd.read_csv(rna_path, encoding='latin1'))\n","rna_df = rna_df.select_dtypes(include=[np.number]).fillna(0)\n","\n","# Build Survival Target DataFrame\n","# demo_path is auto-discovered above\n","demo_df = pd.read_csv(demo_path, encoding='latin1')\n","demo_df = standardize_id(demo_df).reset_index()\n","# Bulletproof Pan-Cancer Survival Target Locator\n","event_col = next((c for c in demo_df.columns if any(x in c.lower() for x in ['status', 'event', 'vital', 'os_'])), demo_df.columns[-1])\n","death_col = next((c for c in demo_df.columns if 'death' in c.lower() or 'os' in c.lower()), None)\n","follow_col = next((c for c in demo_df.columns if 'follow' in c.lower()), None)\n","\n","# Parse Event (1.0 = Dead, 0.0 = Alive)\n","demo_df['event'] = demo_df[event_col].apply(lambda x: 1.0 if any(d in str(x).lower() for d in ['dead', 'deceased', '1']) else 0.0)\n","\n","# Parse Time (Days/Months to Event)\n","if death_col and follow_col:\n","    demo_df['time'] = pd.to_numeric(demo_df[death_col], errors='coerce').fillna(pd.to_numeric(demo_df[follow_col], errors='coerce'))\n","elif death_col:\n","    demo_df['time'] = pd.to_numeric(demo_df[death_col], errors='coerce')\n","elif follow_col:\n","    demo_df['time'] = pd.to_numeric(demo_df[follow_col], errors='coerce')\n","else:\n","    time_col = next((c for c in demo_df.columns if 'time' in c.lower() or 'days' in c.lower()), demo_df.columns[-2])\n","    demo_df['time'] = pd.to_numeric(demo_df[time_col], errors='coerce')\n","\n","demo_df['time'] = demo_df['time'].fillna(0)\n","target_df = demo_df[['Patient_ID', 'time', 'event']].drop_duplicates(subset=['Patient_ID'])\n","\n","# Valid Patients\n","valid_patients = list(set(target_df['Patient_ID']) & (set(cli_df.index) | set(rna_df.index)))\n","target_df = target_df[target_df['Patient_ID'].isin(valid_patients)].reset_index(drop=True)\n","\n","train_df = target_df.iloc[:int(0.8*len(target_df))]\n","val_df   = target_df.iloc[int(0.8*len(target_df)):]\n","\n","train_dl = DataLoader(PanCancerDataset(train_df, rna_df, cli_df), batch_size=CFG['batch_size'], shuffle=True, drop_last=True, num_workers=CFG['num_workers'])\n","val_dl   = DataLoader(PanCancerDataset(val_df, rna_df, cli_df), batch_size=CFG['batch_size'], shuffle=False, num_workers=CFG['num_workers'])\n","\n","model = CancerFusionPhase2(rna_dim=rna_df.shape[1], cli_dim=cli_df.shape[1]).to(DEVICE)\n","optimizer = torch.optim.AdamW(model.parameters(), lr=CFG['lr'], weight_decay=1e-4)\n","print(\"✅ Phase 2 Data & Engine Ready!\")"]},{"cell_type":"code","execution_count":7,"id":"04a5ae2c","metadata":{"execution":{"iopub.execute_input":"2026-09-12T08:03:09.659263Z","iopub.status.busy":"2026-09-12T08:03:09.658668Z","iopub.status.idle":"2026-09-12T09:51:11.155502Z","shell.execute_reply":"2026-09-12T09:51:11.154726Z"},"papermill":{"duration":6481.512312,"en