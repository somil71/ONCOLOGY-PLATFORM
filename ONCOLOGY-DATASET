","=================================================================\n"]}],"source":["\n","# Cell 2 — Imports and CFG\n","import os, json, time, glob, warnings\n","warnings.filterwarnings('ignore')\n","\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","from tqdm.auto import tqdm\n","from PIL import Image\n","\n","import torch\n","import torch.nn as nn\n","import torch.nn.functional as F\n","import torch.optim as optim\n","from torch.utils.data import Dataset, DataLoader\n","import torchvision.transforms as T\n","from torchvision.models import vit_b_16, ViT_B_16_Weights\n","from lifelines import KaplanMeierFitter\n","\n","# High-Performance Backend\n","torch.backends.cudnn.benchmark = True\n","if DEVICE == 'cuda':\n","    torch.backends.cuda.matmul.allow_tf32 = True\n","\n","CFG = {\n","    'batch_size': 32,\n","    'epochs': 50,\n","    'lr': 1e-3,\n","    'weight_decay': 1e-4,\n","    'max_patches': 100,\n","    'wsi_dim': 768,\n","    'rna_dim': None, # Auto-detected\n","    'cli_dim': None, # Auto-detected\n","    'dir_multimodal': \"/kaggle/input/datasets/sepehreslamimoghadam/breast-cancer-vision-and-genomic-fusion-ml-ready\",\n","    'num_workers': 0,\n","}\n","\n","print('\\n' + '='*65)\n","print('  CancerFusion Configuration')\n","print('='*65)\n","print(f'  Batch Size : {CFG[\"batch_size\"]}')\n","print(f'  Epochs     : {CFG[\"epochs\"]}')\n","print(f'  Learn Rate : {CFG[\"lr\"]}')\n","print(f'  WSI Patches: {CFG[\"max_patches\"]} per patient')\n","print('='*65)\n"]},{"cell_type":"markdown","id":"a31245a3","metadata":{"papermill":{"duration":0.003086,"end_time":"2026-09-09T19:10:23.367204+00:00","exception":false,"start_time":"2026-09-09T19:10:23.364118+00:00","status":"completed"},"tags":[]},"source":["## Cell 3 — Pretrained Vision Transformer (Feature Extractor)"]},{"cell_type":"code","execution_count":3,"id":"2c7e6846","metadata":{"execution":{"iopub.execute_input":"2026-09-09T19:10:23.374307Z","iopub.status.busy":"2026-09-09T19:10:23.373959Z","iopub.status.idle":"2026-09-09T19:10:26.624932Z","shell.execute_reply":"2026-09-09T19:10:26.624104Z"},"papermill":{"duration":3.256193,"end_time":"2026-09-09T19:10:26.626463+00:00","exception":false,"start_time":"2026-09-09T19:10:23.37027+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[*] Loading Vision Transformer (ViT-B/16)...\n","Downloading: \"https://download.pytorch.org/models/vit_b_16-c867db91.pth\" to /root/.cache/torch/hub/checkpoints/vit_b_16-c867db91.pth\n"]},{"name":"stderr","output_type":"stream","text":["100%|██████████| 330M/330M [00:01<00:00, 234MB/s]\n"]},{"name":"stdout","output_type":"stream","text":["✅ ViT loaded | Params: 85,798,656 | Output Dim: 768\n"]}],"source":["\n","# Cell 3 — ViT Setup\n","print(\"[*] Loading Vision Transformer (ViT-B/16)...\")\n","vision_model = vit_b_16(weights=ViT_B_16_Weights.DEFAULT).to(DEVICE)\n","vision_model.heads = nn.Identity() # Strip classification head for raw 768d embedding\n","vision_model.eval()\n","\n","wsi_transform = T.Compose([\n","    T.Resize((224, 224)),\n","    T.ToTensor(),\n","    T.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n","])\n","\n","vit_params = sum(p.numel() for p in vision_model.parameters())\n","print(f\"✅ ViT loaded | Params: {vit_params:,} | Output Dim: 768\")\n"]},{"cell_type":"markdown","id":"9ccd271a","metadata":{"papermill":{"duration":0.003523,"end_time":"2026-09-09T19:10:26.633831+00:00","exception":false,"start_time":"2026-09-09T19:10:26.630308+00:00","status":"completed"},"tags":[]},"source":["## Cell 4 — TCGADataset & Dataloader (Multimodal Linking)"]},{"cell_type":"code","execution_count":4,"id":"beb1ddc7","metadata":{"execution":{"iopub.execute_input":"2026-09-09T19:10:26.642247Z","iopub.status.busy":"2026-09-09T19:10:26.642033Z","iopub.status.idle":"2026-09-09T19:10:26.759804Z","shell.execute_reply":"2026-09-09T19:10:26.758806Z"},"papermill":{"duration":0.123921,"end_time":"2026-09-09T19:10:26.761282+00:00","exception":false,"start_time":"2026-09-09T19:10:26.637361+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","[*] Parsing Kaggle Dataset: breast-cancer-vision-and-genomic-fusion-ml-ready\n","✅ Dataloaders Ready\n","   Train: 97 patients | Val: 25 patients\n","   Detected Input Shapes -> RNA: 331d | Clinical: 9d\n"]}],"source":["\n","# Cell 4 — Dataset\n","class TCGADataset(Dataset):\n","    def __init__(self, is_train=True):\n","        print(f\"\\n[*] Parsing Kaggle Dataset: {CFG['dir_multimodal'].split('/')[-1]}\")\n","        \n","        # 1. Clinical Data\n","        cli_df = pd.read_csv(f\"{CFG['dir_multimodal']}/Clinical_Demographic_Data.csv\").fillna(0)\n","        \n","        # 2. Genomics Data\n","        rna_df = pd.read_csv(f\"{CFG['dir_multimodal']}/RNA_CNV_ModelReady.csv\").fillna(0)\n","        \n","        # Time & Event extraction with TCGA fallbacks\n","        time_dead = pd.to_numeric(cli_df.get('demographic_days_to_death', pd.Series()), errors='coerce')\n","        time_alive = pd.to_numeric(cli_df.get('diagnoses_days_to_last_follow_up', pd.Series()), errors='coerce')\n","        \n","        if time_dead.empty and time_alive.empty:\n","            time_vals = pd.to_numeric(cli_df.get('survival_time', cli_df.iloc[:, 1]), errors='coerce').fillna(0)\n","            event_vals = pd.to_numeric(cli_df.get('event', cli_df.iloc[:, 2]), errors='coerce').fillna(0)\n","        else:\n","            time_vals = time_dead.fillna(time_alive).fillna(0) \n","            event_vals = (cli_df['demographic_vital_status'].astype(str).str.strip().str.lower() == 'dead').astype(float)\n","            \n","        self.time = torch.tensor(time_vals.values, dtype=torch.float32)\n","        self.event = torch.tensor(event_vals.values, dtype=torch.float32)\n","        \n","        # Features\n","        drop_cols = ['demographic_days_to_death', 'diagnoses_days_to_last_follow_up', 'demographic_vital_status', 'survival_time', 'event']\n","        cli_features = cli_df.drop(columns=[c for c in drop_cols if c in cli_df.columns]).select_dtypes(include=[np.number]).fillna(0)\n","        \n","        self.cli = torch.tensor(cli_features.values, dtype=torch.float32)\n","        self.rna = torch.tensor(rna_df.select_dtypes(include=[np.number]).values, dtype=torch.float32)\n","        \n","        self.patient_ids = cli_df.get('Patient_ID', cli_df.iloc[:, 0]).astype(str).values\n","        self.wsi_folder = f\"{CFG['dir_multimodal']}/MRI_and_SVS_Patches/MRI_and_SVS_Patches\"\n","        \n","        self.n_samples = len(cli_df)\n","        self.mask = torch.ones(self.n_samples, 3) # MNAR Masking Support\n","\n","        CFG['cli_dim'] = self.cli.shape[1]\n","        CFG['rna_dim'] = self.rna.shape[1]\n","\n","    def __len__(self): return self.n_samples\n","    \n","    def __getitem__(self, idx):\n","        patient_id = self.patient_ids[idx]\n","        # Extremely fast targeted folder search\n","        patch_paths = glob.glob(f\"{self.wsi_folder}/{patient_id}/**/*\", recursive=True)\n","        patch_paths = [p for p in patch_paths if os.path.isfile(p)]\n","        \n","        wsi_tensor = torch.zeros(CFG['max_patches'], CFG['wsi_dim']) \n","        \n","        if len(patch_paths) > 0:\n","            patches_to_load = patch_paths[:CFG['max_patches']]\n","            loaded_images = []\n","            for p in patches_to_load:\n","                try:\n","                    # Attempt 1: Standard Image Formats (JPG/PNG)\n","                    img = Image.open(p).convert('RGB')\n","                    loaded_images.append(wsi_transform(img))\n","                except Exception:\n","                    try:\n","                        # Attempt 2: Raw Medical DICOM Formats (TCIA standard)\n","                        import pydicom\n","                        ds = pydicom.dcmread(p)\n","                        arr = ds.pixel_array.astype(float)\n","                        # Normalize raw medical pixels to RGB\n","                        arr = (arr - np.min(arr)) / (np.max(arr) - np.min(arr) + 1e-8)\n","                        arr = (arr * 255).astype(np.uint8)\n","                        \n","                        if len(arr.shape) == 2:\n","                            img = Image.fromarray(arr).convert('RGB')\n","                        elif len(arr.shape) > 2:\n","                            img = Image.fromarray(arr[0]).convert('RGB') # Take first slice if 3D MRI\n","                        \n","                        loaded_images.append(wsi_transform(img))\n","                    except Exception:\n","                        pass\n","            \n","            if len(loaded_images) > 0:\n","                with torch.no_grad():\n","                    img_batch = torch.stack(loaded_images).to(DEVICE)\n","                    features = vision_model(img_batch).cpu()\n","                    wsi_tensor[:features.size(0), :] = features\n","\n","        return {'wsi': wsi_tensor, 'rna': self.rna[idx], 'cli': self.cli[idx],\n","                'mask': self.mask[idx], 'time': self.time[idx], 'event': self.event[idx]}\n","\n","# Initialize Dataset to globally set dimensions\n","full_ds = TCGADataset(is_train=True)\n","train_size = int(0.8 * len(full_ds))\n","val_size = len(full_ds) - train_size\n","train_ds, val_ds = torch.utils.data.random_split(full_ds, [train_size, val_size])\n","\n","train_dl = DataLoader(train_ds, batch_size=CFG['batch_size'], shuffle=True, drop_last=True, num_workers=CFG['num_workers'])\n","val_dl = DataLoader(val_ds, batch_size=CFG['batch_size'], shuffle=False, num_workers=CFG['num_workers'])\n","\n","print(f\"✅ Dataloaders Ready\")\n","print(f\"   Train: {len(train_ds):,} patients | Val: {len(val_ds):,} patients\")\n","print(f\"   Detected Input Shapes -> RNA: {CFG['rna_dim']}d | Clinical: {CFG['cli_dim']}d\")\n"]},{"cell_type":"markdown","id":"ad7d21d1","metadata":{"papermill":{"duration":0.003881,"end_time":"2026-09-09T19:10:26.7689+00:00","exception":false,"start_time":"2026-09-09T19:10:26.765019+00:00","status":"completed"},"tags":[]},"source":["## Cell 5 — Unimodal Encoders (WSI, RNA, Clinical)"]},{"cell_type":"code","execution_count":5,"id":"9a12cbf3","metadata":{"execution":{"iopub.execute_input":"2026-09-09T19:10:26.777417Z","iopub.status.busy":"2026-09-09T19:10:26.777088Z","iopub.status.idle":"2026-09-09T19:10:26.783504Z","shell.execute_reply":"2026-09-09T19:10:26.782934Z"},"papermill":{"duration":0.012368,"end_time":"2026-09-09T19:10:26.784946+00:00","exception":false,"start_time":"2026-09-09T19:10:26.772578+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["\n","# Cell 5 — Encoders\n","class ClinicalEncoder(nn.Module):\n","    def __init__(self, input_dim):\n","        super().__init__()\n","        self.net = nn.Sequential(\n","            nn.Linear(input_dim, 64), \n","            nn.BatchNorm1d(64), \n","            nn.ReLU(), \n","            nn.Dropout(0.2), \n","            nn.Linear(64, 128)\n","        )\n","    def forward(self, x): return self.net(x)\n","\n","class GenomicEncoder(nn.Module):\n","    def __init__(self, input_dim):\n","        super().__init__()\n","        self.net = nn.Sequential(\n","            nn.Linear(input_dim, 256), \n","            nn.SELU(), \n","            nn.AlphaDropout(0.1), \n","            nn.Linear(256, 128)\n","        )\n","    def forward(self, x): return self.net(x)\n","\n","class WSIConceptBottleneck(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","        self.concept_layer = nn.Linear(CFG['wsi_dim'], 16)\n","        self.projection = nn.Linear(16, 128)\n","    def forward(self, x):\n","        x_bag = torch.mean(x, dim=1) # MIL Aggregation\n","        concepts = torch.sigmoid(self.concept_layer(x_bag))\n","        return self.projection(concepts), concepts\n"]},{"cell_type":"markdown","id":"13d4cc27","metadata":{"papermill":{"duration":0.003547,"end_time":"2026-09-09T19:10:26.792045+00:00","exception":false,"start_time":"2026-09-09T19:10:26.788498+00:00","status":"completed"},"tags":[]},"source":["## Cell 6 — Safe Attention Fusion & Evidential Head"]},{"cell_type":"code","execution_count":6,"id":"dc791edb","metadata":{"execution":{"iopub.execute_input":"2026-09-09T19:10:26.800296Z","iopub.status.busy":"2026-09-09T19:10:26.800099Z","iopub.status.idle":"2026-09-09T19:10:26.80648Z","shell.execute_reply":"2026-09-09T19:10:26.80593Z"},"papermill":{"duration":0.012134,"end_time":"2026-09-09T19:10:26.807886+00:00","exception":false,"start_time":"2026-09-09T19:10:26.795752+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["\n","# Cell 6 — Fusion & Evidential Logic\n","class SafeAttentionFusion(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","        self.score_net = nn.Sequential(\n","            nn.Linear(128, 32), \n","            nn.Tanh(), \n","            nn.Linear(32, 1)\n","        )\n","    def forward(self, embeds, mask):\n","        stacked = torch.stack(embeds, dim=1) \n","        scores = self.score_net(stacked).squeeze(-1) \n","        \n","        # Safety Masking for MNAR (Missing Not At Random)\n","        scores = scores.masked_fill(mask == 0, float('-inf'))\n","        scores[(mask.sum(dim=1) == 0), :] = 0.0\n","        \n","        weights = F.softmax(scores, dim=1)\n","        return (stacked * weights.unsqueeze(-1)).sum(dim=1), weights\n","\n","class EvidentialHead(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","        self.evidence = nn.Linear(128, 2)\n","    def forward(self, fused):\n","        e = torch.clamp(F.softplus(self.evidence(fused)), min=0.0, max=1e3) \n","        alpha = e + 1\n","        S = torch.sum(alpha, dim=1, keepdim=True)\n","        return alpha[:, 1] / S.squeeze(-1), 2.0 / S.squeeze(-1)\n"]},{"cell_type":"markdown","id":"48a89ae3","metadata":{"papermill":{"duration":0.003582,"end_time":"2026-09-09T19:10:26.814993+00:00","exception":false,"start_time":"2026-09-09T19:10:26.811411+00:00","status":"completed"},"tags":[]},"source":["## Cell 7 — CancerFusion Hybrid Model Assembly"]},{"cell_type":"code","execution_count":7,"id":"bac0f1e1","metadata":{"execution":{"iopub.execute_input":"2026-09-09T19:10:26.823316Z","iopub.status.busy":"2026-09-09T19:10:26.823122Z","iopub.status.idle":"2026-09-09T19:10:26.833087Z","shell.execute_reply":"2026-09-09T19:10:26.832423Z"},"papermill":{"duration":0.015738,"end_time":"2026-09-09T19:10:26.83441+00:00","exception":false,"start_time":"2026-09-09T19:10:26.818672+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","✅ CancerFusion Model Compiled\n","   Trainable Parameters: 145,875\n"]}],"source":["\n","# Cell 7 — Hybrid Model\n","class CancerFusionHybrid(nn.Module):\n","    def __init__(self, rna_dim, cli_dim):\n","        super().__init__()\n","        self.wsi_enc = WSIConceptBottleneck()\n","        self.rna_enc = GenomicEncoder(rna_dim)\n","        self.cli_enc = ClinicalEncoder(cli_dim)\n","        self.fusion  = SafeAttentionFusion()\n","        self.head    = EvidentialHead()\n","        \n","    def forward(self, wsi, rna, cli, mask):\n","        w, c_scores = self.wsi_enc(wsi)\n","        fused, attn = self.fusion([w, self.rna_enc(rna), self.cli_enc(cli)], mask)\n","        risk, unc   = self.head(fused)\n","        return risk, unc, attn, c_scores\n","\n","model = CancerFusionHybrid(rna_dim=CFG['rna_dim'], cli_dim=CFG['cli_dim']).to(DEVICE)\n","train_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n","\n","print(f\"\\n✅ CancerFusion Model Compiled\")\n","print(f\"   Trainable Parameters: {train_params:,}\")\n"]},{"cell_type":"markdown","id":"efdfd563","metadata":{"papermill":{"duration":0.003594,"end_time":"2026-09-09T19:10:26.841618+00:00","exception":false,"start_time":"2026-09-09T19:10:26.838024+00:00","status":"completed"},"tags":[]},"source":["## Cell 8 — Cox Proportional Hazards Loss & Optimizer"]},{"cell_type":"code","execution_count":8,"id":"2e14e509","metadata":{"execution":{"iopub.execute_input":"2026-09-09T19:10:26.850044Z","iopub.status.busy":"2026-09-09T19:10:26.849768Z","iopub.status.idle":"2026-09-09T19:10:26.855284Z","shell.execute_reply":"2026-09-09T19:10:26.854418Z"},"papermill":{"duration":0.011349,"end_time":"2026-09-09T19:10:26.856729+00:00","exception":false,"start_time":"2026-09-09T19:10:26.84538+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["✅ Optimizer: AdamW | LR: 0.001 | WD: 0.0001\n"]}],"source":["\n","# Cell 8 — Loss & Optimizer\n","def cox_loss(risk, times, events):\n","    sorted_idx = torch.argsort(times, descending=True)\n","    risk, events = risk[sorted_idx], events[sorted_idx]\n","    hr = torch.exp(torch.clamp(risk, max=20.0))\n","    log_risk = torch.log(torch.cumsum(hr, dim=0) + 1e-8)\n","    return -torch.sum((risk - log_risk) * events) / (torch.sum(events) + 1e-8)\n","\n","optimizer = optim.AdamW(model.parameters(), lr=CFG['lr'], weight_decay=CFG['weight_decay'])\n","print(f\"✅ Optimizer: AdamW | LR: {CFG['lr']} | WD: {CFG['weight_decay']}\")\n"]},{"cell_type":"markdown","id":"bffaa303","metadata":{"papermill":{"duration":0.004156,"end_time":"2026-09-09T19:10:26.864572+00:00","exception":false,"start_time":"2026-09-09T19:10:26.860416+00:00","status":"completed"},"tags":[]},"source":["## Cell 9 — Training Engine"]},{"cell_type":"code","execution_count":9,"id":"d6a33b0f","metadata":{"execution":{"iopub.execute_input":"2026-09-09T19:10:26.873432Z","iopub.status.busy":"2026-09-09T19:10:26.873024Z","iopub.status.idle":"2026-09-10T03:22:06.01251Z","shell.execute_reply":"2026-09-10T03:22:06.011622Z"},"papermill":{"duration":29499.15656,"end_time":"2026-09-10T03:22:06.024871+00:00","exception":false,"start_time":"2026-09-09T19:10:26.868311+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"std